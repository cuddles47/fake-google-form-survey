# Google Form configuration
# URL for the form's response submission endpoint (important: use formResponse URL not the viewform URL)
FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID_HERE/formResponse

# Form field mappings (entry IDs)
# These IDs map to specific form fields - find them by inspecting the form HTML
FIELD_CLASS=entry.1673755276
FIELD_GENDER=entry.803366471
FIELD_PREFERENCE=entry.975913696
FIELD_INTEREST=entry.557521012
FIELD_EQ_KNOWLEDGE=entry.1110732521
FIELD_RELATION=entry.1059103494
FIELD_EXPRESSION=entry.2069632588
FIELD_EMOTION=entry.143017696
FIELD_DISCUSSION=entry.1824094941
FIELD_IMPROVEMENT=entry.1940461153
FIELD_IMPORTANCE=entry.61104916
FIELD_SUGGESTION=entry.1675741628

# Runtime configuration
# Number of responses to generate
NUM_RESPONSES=60
# Minimum delay between submissions (seconds)
MIN_DELAY=1.5
# Maximum delay between submissions (seconds)
MAX_DELAY=4.0

# Enable/disable verbose logging (true/false)
VERBOSE_LOGGING=true
